{
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell",
      "PowerShell(:*)",
      "Bash(grep -E \"\\\\.\\(ts|tsx|cs\\)$\")",
      "Bash(xargs grep:*)",
      "Edit(/.claude/skills/doc-loader/**)",
      "Edit(/.claude/skills/pattern-finder/**)",
      "Edit(/.claude/skills/skill-loader/**)",
      "Edit(/.claude/skills/doc-monitor/**)",
      "Edit(/.claude/skills/doc-cleanup/**)",
      "Edit(/.claude/skills/doc-optimize/**)",
      "Edit(/.claude/skills/doc-update-guide/**)",
      "Edit(/.claude/skills/doc-update-reference/**)",
      "Edit(/.claude/skills/doc-update-technical/**)",
      "Edit(/.claude/skills/post-feature/**)",
      "Edit(/.claude/skills/release-notes/**)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Skill(keybindings-help)",
      "Skill(keybindings-help:*)",
      "Skill(claude-api)",
      "Skill(claude-api:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vite:*)",
      "Bash(dotnet build:*)",
      "Bash(node devtools/dev.mjs:*)",
      "Bash(node devtools/scripts/:*)",
      "Bash(node devtools/downscale.mjs:*)",
      "Bash(node devtools/knowledge-check.mjs:*)",
      "Bash(node devtools/context-footprint.mjs:*)",
      "Bash(node devtools/new-rule.mjs:*)",
      "Bash(xargs head:*)",
      "Bash(npx react-scripts:*)",
      "Bash(dotnet test:*)",
      "Bash(npm ls:*)",
      "Bash(npx jest:*)",
      "Bash(ls node_modules/.bin/jest)",
      "Bash(ls node_modules/.bin/vitest)",
      "Bash(ls node_modules/jest/package.json)",
      "Bash(ls node_modules/vitest/package.json)",
      "Bash(ls tsconfig*.json)",
      "Bash(ls node_modules/jest)",
      "Bash(ls node_modules/ts-jest)",
      "Bash(ls node_modules/react-scripts)",
      "Bash(ls node_modules/@swc)",
      "Bash(grep -r \"CachePath\\\\|archivePath\\\\|ArchivePath\" D3dxSkinManager/Modules/Mod/Services/*.cs)",
      "Bash(grep -E \"\\\\.cs$\")",
      "Bash(grep -E \"\\\\.\\(cs|sql\\)$\")",
      "Bash(grep -E \"\\\\.\\(ts|tsx\\)$\")"
    ],
    "additionalDirectories": [
      ".claude",
      ".claude/rules",
      ".claude/skills"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[GATE] Coding task? FIRST tool calls MUST be all 4 core skills in parallel:\\n  1. Skill(skill-loader, args=\"task description\")\\n  2. Skill(doc-loader, args=\"task description scope\")\\n  3. Skill(pattern-finder, args=\"PatternType Module\")\\n  4. Skill(caveman)\\nThen: read routed docs → SCAN .claude/rules/RULES_INDEX.md + Read every matched .claude/knowledge/*.md rule (bodies are NOT auto-loaded) → invoke INVOKE list → print match summary → only THEN explore code.\\nSkipping ANY skill or an unread matched rule = non-conforming code. Zero exceptions for \"I already know\" or \"simple fix\".'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[SKILL-CHECK] Did you state and invoke the code-gen skill for this change? Hand-write only unique business logic inside skill-generated structures. (CLAUDE.md §0.3)'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  }
}
