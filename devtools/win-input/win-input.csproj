<Project Sdk="Microsoft.NET.Sdk">
  <!-- Background native MOUSE input to the real D3dxSkinManager window via Win32 PostMessage (technique borrowed
       from MaaNTE / MaaFramework: FindWindow + PostMessage to a background HWND + a WM_ACTIVATE wake — no
       real cursor move, no focus steal, occlusion-immune). Lets the agent self-verify NATIVE surfaces the
       DOM/CDP can't reach (the LibVLC overlay + the enhance compositor's pills/wipe/right-click menu),
       which were previously "user-verify only". Dev tool — never shipped in the app build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>win-input</AssemblyName>
  </PropertyGroup>
</Project>
