{
  // Built-in adapter for huihui168.org ("Hui站") — patterns verified live 2026-07-05
  // (see .claude/knowledge/remote-library.md). Shipped as a SEED: copied into
  // {data}/remote-sources/ only when no adapter with this id exists there, so user edits
  // (e.g. baseUrl when the site moves hosts) are never overwritten.
  "id": "huihui",
  "name": "Hui站",
  "baseUrl": "https://huihui168.org",
  "engine": "http",
  // Card thumbnails are cover-cropped in a 3:4 box; huihui art has the subject high, so bias the crop
  // toward the top (keep more of the top, trim from the bottom) instead of centering.
  "thumbnail": { "position": "50% 20%" },
  "lists": [
    { "id": "2", "name": "绝区零" },
    { "id": "1", "name": "鸣潮" },
    { "id": "3", "name": "星穹铁道" },
    { "id": "4", "name": "终末地" }
  ],
  "listUrlFirstPage": "/?list_{list}/",
  "listUrlTemplate": "/?list_{list}_{page}/",
  "searchUrlTemplate": "/?keyword={query}",
  "cardPattern": "<a[^>]+href=\"(?<url>/\\?news_[^\"]+)\"[^>]*>[\\s\\S]{0,600}?<img[^>]+src=\"(?<image>[^\"]+)\"[^>]*alt=\"(?<title>[^\"]*)\"",
  "cardScopePattern": "最近更新</h2>(?<scope>[\\s\\S]*)",
  "totalPagesPattern": "href=\"/\\?list_{list}_(?<pages>\\d+)/\"",
  "detailTitlePattern": "<h1[^>]*>(?<title>[\\s\\S]*?)</h1>",
  // Detail page = left content column (lg:w-3/4: artwork + rich-text body) + right sidebar
  // (lg:w-1/4: avatar, third-party ads, related mods). Scope extraction to the LEFT column —
  // the sidebar images polluted the gallery (verified on ?news_14/9288.html, 2026-07-06).
  "detailScopePattern": "lg:w-3/4(?<scope>[\\s\\S]*?)lg:w-1/4",
  "detailImagePattern": "<img[^>]+src=\"(?<image>/static/upload/[^\"]+)\"",
  // The rich-text body after the <h1> (download labels, unzip password, switch keys).
  "detailDescriptionPattern": "</h1>(?<description>[\\s\\S]*?)<div class=",
  "downloadLinkPattern": "<a[^>]+href=\"(?<url>https?://[^\"]+)\"",
  "entryIdPattern": "news_\\d+/(?<id>\\d+)\\.html",
  "imageDatePattern": "/(?<date>20\\d{6})/",
  // The site has no tag taxonomy; titles usually lead with the character name before the first
  // space ("安比 星见雅换装") — derive that word as the entry's tag (titles without a space get none).
  "titleTagPattern": "^(?<tag>\\S+)\\s",
  // unzipPassword: the site's stated archive password (解压密码：huihui). Import extracts WITHOUT a
  // password first and uses this only when that fails with a password error.
  // unwrapNested: huihui's Quark uploads are a "safe keep" disguise — a real .mp4 with a zip appended,
  // wrapping a password-protected 7z, wrapping the mod (multiple layers). unwrapNested runs the
  // recursive-unwrap workflow (carve + multi-layer + password-per-layer) to reach the real mod.
  // Hui盘 has TWO backends (grounded 2026-07-14): the main host cloudreve.huihui123.org is Cloudreve v4
  // (path form /s/<key>); some mods instead link an IP/VPN mirror (e.g. http://174.136.207.5/#s/<key>)
  // that runs kodbox 1.62 — a DIFFERENT share API (share/get → fileDownload GET). The kodbox SPA hash
  // route (/#s/) is the discriminator; it never collides with Cloudreve (/s/), Quark (pan.quark.cn/s/),
  // or MEGA (#<key>, no s/). An unmatched download link is DROPPED (HttpRegexEngine) — before this rule,
  // mods on the IP mirror showed ONLY the flaky Quark button.
  "resolvers": [
    { "match": "^https?://cloudreve\\.", "type": "cloudreve", "name": "Hui盘", "unzipPassword": "huihui" },
    { "match": "^https?://pan\\.quark\\.cn/", "type": "quark", "name": "夸克", "unzipPassword": "huihui", "unwrapNested": true },
    { "match": "^https?://mega\\.nz/folder/", "type": "mega", "name": "MEGA" },
    { "match": "/#s/", "type": "kodbox", "name": "Hui盘", "unzipPassword": "huihui" }
  ],
  // Auto-detect fallback: when a download link matches NONE of the resolvers above, probe its host once
  // for the kodbox fingerprint (cached) and, on a hit, treat it as Hui盘/kodbox. Catches a Hui盘 mirror
  // moved to a new IP/host whose share-URL shape the `/#s/` rule doesn't match (e.g. a `/s/<key>` path
  // form). Only share-shaped URLs (`/s/`, `/#s/`) are probed — ad/social links are never touched.
  "autoDetect": ["kodbox"]
}
